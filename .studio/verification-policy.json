{
  "schemaVersion": 1,
  "note": "Verification tiers and adaptive evaluation policy. V0-V2 use current Studio affected/verification tooling with Nx assistance; V3/V4 map to the existing serialized repository gates. Evaluator profile roles resolve through .studio/models.json.",
  "tiers": {
    "V0": {
      "purpose": "edit loop",
      "when": "while implementing, before completion claims",
      "evidence": [
        "one focused test file or --project selection",
        "content compiler check on touched sources (pnpm content:check)",
        "formatter/lint on touched paths"
      ],
      "notes": [
        "compact execution wrapper available: pnpm studio:exec -- <command> keeps the full log under .studio/runtime/logs and returns a compact PASS/FAIL block"
      ]
    },
    "V1": {
      "purpose": "worker completion / affected evidence",
      "when": "before returning DONE for a task batch",
      "evidence": [
        "tests of affected projects/zones derived from Studio context plus Nx affected project/task information",
        "affected compiler/schema checks when content or schema inputs changed",
        "focused Storybook/browser checks when UI changed",
        "determinism/golden/simulation evidence when gameplay rules changed"
      ],
      "notes": [
        "pnpm studio:affected + pnpm studio:verify -- --tier V1 assemble and run this set; avoid widening to V3 during the edit loop"
      ]
    },
    "V2": {
      "purpose": "PR candidate",
      "when": "before requesting merge",
      "evidence": [
        "all affected projects: typecheck/lint/tests",
        "browser UI verification when UI changed",
        "focused Rust verification when persistence/platform changed",
        "no duplicated typecheck inside build chains"
      ],
      "notes": [
        "pnpm studio:verify -- --tier V2 assembles the candidate set using current affected/Nx information"
      ]
    },
    "V3": {
      "purpose": "full merge gate",
      "command": "pnpm verify",
      "concurrency": "serialized: fullGateSlots=1 (.studio/project.json); one full-gate slot at a time",
      "notes": [
        "workers must not run V3 after every small edit"
      ]
    },
    "V4": {
      "purpose": "release readiness",
      "command": "pnpm verify:release",
      "concurrency": "serialized, after V3",
      "notes": [
        "release packaging/migration/security/signing evidence requires explicit assignment and human review"
      ]
    }
  },
  "adaptiveReview": {
    "mode": "shadow",
    "evaluatorProfiles": {
      "tester": "lunaTester",
      "reviewerR1R2": "lunaReviewer",
      "reviewerR3": "r3Reviewer",
      "crossFamily": "crossFamilyReviewer"
    },
    "changeClasses": [
      {
        "id": "docs-generated-only",
        "riskMinimum": "R1",
        "deterministicGate": "required (docs:check/build-toc)",
        "tester": { "mode": "none", "profileRole": null },
        "reviewer": { "mode": "sampled", "profileRole": "reviewerR1R2" },
        "crossFamily": { "mode": "none", "profileRole": null },
        "humanReview": false
      },
      {
        "id": "format-config-trivial",
        "riskMinimum": "R1",
        "deterministicGate": "required (fmt/lint/check-config)",
        "tester": { "mode": "none", "profileRole": null },
        "reviewer": { "mode": "conditional", "profileRole": "reviewerR1R2" },
        "crossFamily": { "mode": "none", "profileRole": null },
        "humanReview": false
      },
      {
        "id": "ui-style",
        "riskMinimum": "R1",
        "deterministicGate": "storybook/browser affected checks",
        "tester": { "mode": "optional", "profileRole": "tester" },
        "reviewer": { "mode": "required", "profileRole": "reviewerR1R2" },
        "crossFamily": { "mode": "none", "profileRole": null },
        "humanReview": false
      },
      {
        "id": "pure-helper",
        "riskMinimum": "R1",
        "deterministicGate": "unit/type/lint focused",
        "tester": { "mode": "optional", "profileRole": "tester" },
        "reviewer": { "mode": "required", "profileRole": "reviewerR1R2" },
        "crossFamily": { "mode": "none", "profileRole": null },
        "humanReview": false
      },
      {
        "id": "gameplay",
        "riskMinimum": "R2",
        "deterministicGate": "focused tests + deterministic simulation/property/replay evidence as applicable",
        "tester": { "mode": "required", "profileRole": "tester" },
        "reviewer": { "mode": "required", "profileRole": "reviewerR1R2" },
        "crossFamily": { "mode": "conditional", "profileRole": "crossFamily" },
        "humanReview": false
      },
      {
        "id": "complex-cross-domain",
        "riskMinimum": "R2_COMPLEX",
        "deterministicGate": "full affected set",
        "tester": { "mode": "required", "profileRole": "tester" },
        "reviewer": { "mode": "required", "profileRole": "reviewerR1R2" },
        "crossFamily": { "mode": "optional", "profileRole": "crossFamily" },
        "humanReview": false
      },
      {
        "id": "persistence-schema-determinism",
        "riskMinimum": "R3",
        "deterministicGate": "focused + compatibility + replay evidence",
        "tester": { "mode": "required", "profileRole": "tester" },
        "reviewer": { "mode": "required", "profileRole": "reviewerR3" },
        "crossFamily": { "mode": "conditional", "profileRole": "crossFamily" },
        "humanReview": true
      },
      {
        "id": "release-signing-security",
        "riskMinimum": "R3",
        "deterministicGate": "explicit full gates (V4)",
        "tester": { "mode": "required", "profileRole": "tester" },
        "reviewer": { "mode": "required", "profileRole": "reviewerR3" },
        "crossFamily": { "mode": "conditional", "profileRole": "crossFamily" },
        "humanReview": true
      }
    ],
    "neverWeakenReviewFor": [
      "visual composition",
      "game feel",
      "architecture trade-off",
      "historical semantic fact",
      "security boundary",
      "migration semantics"
    ],
    "activationCriteria": {
      "minimumAcceptedTasks": 30,
      "maximumEscapedS0S1": 0,
      "minimumCleanReviewWaves": 2,
      "requireRecordedTaskMetrics": true
    },
    "samplingPolicy": {
      "allowedFor": ["docs-generated-only", "format-config-trivial"],
      "escalationTrigger": "repeated finding class in a sampled category raises sampling rate to 1-of-1 until two clean review waves pass"
    }
  }
}
