{
  "schemaVersion": 1,
  "policy": {
    "load": "lazy",
    "maxInitialDocs": 5,
    "maxInitialFiles": 8,
    "followReferencesOnlyWhenNeeded": true,
    "neverBulkLoad": ["docs/MANIFEST.jsonc", "docs/CATALOG.md"]
  },
  "base": ["AGENTS.md", "GAME.md", "docs/INDEX.md"],
  "zones": {
    "core": {
      "agentGuide": "docs/agents/CORE-AGENT.md",
      "docs": ["docs/architecture/**", "docs/game-design/**", "docs/adr/**"],
      "code": ["packages/game-core/**", "packages/game-schema/**", "packages/shared-kernel/**"]
    },
    "persistence": {
      "agentGuide": "docs/agents/ARCHITECT-AGENT.md",
      "docs": ["docs/persistence/**", "docs/architecture/**", "docs/adr/**"],
      "code": ["packages/game-persistence-contracts/**", "packages/game-platform-contracts/**", "apps/desktop/src-tauri/**"]
    },
    "content": {
      "agentGuide": "docs/agents/CONTENT-AGENT.md",
      "docs": ["docs/content/**", "docs/game-design/**", "docs/adr/**"],
      "code": ["content/**", "packages/game-content/**", "packages/game-content-compiler/**", "packages/game-authoring-schema/**"]
    },
    "application": {
      "agentGuide": "docs/agents/ARCHITECT-AGENT.md",
      "docs": ["docs/architecture/**", "docs/game-design/**", "docs/adr/**"],
      "code": ["packages/game-application/**"]
    },
    "ui": {
      "agentGuide": "docs/agents/UI-AGENT.md",
      "docs": ["docs/game-design/**", "docs/architecture/**", "docs/adr/**"],
      "code": ["packages/game-ui/**", "packages/game-ui-fixtures/**", "apps/desktop/src/**"]
    },
    "qa-performance": {
      "agentGuide": "docs/agents/QA-AGENT.md",
      "docs": ["docs/performance/**", "docs/engineering/**"],
      "code": ["tests/**", "scripts/performance/**"]
    },
    "balance": {
      "agentGuide": "docs/agents/ARCHITECT-AGENT.md",
      "docs": ["docs/game-design/**", "docs/architecture/AI-FIRST-GAME-DEVELOPMENT.md", "docs/engineering/**"],
      "code": ["balance/**", "packages/game-authoring-schema/src/balance-schema.ts", "scripts/validate-balance.ts"]
    },
    "scenario": {
      "agentGuide": "docs/agents/ARCHITECT-AGENT.md",
      "docs": ["docs/content/**", "docs/architecture/AI-FIRST-GAME-DEVELOPMENT.md", "docs/engineering/GAMECTL.md"],
      "code": ["content/**/scenarios/**", "packages/game-authoring-schema/src/scenario-schema.ts", "packages/game-devtools/src/scenario/**", "scripts/gamectl-scenario.ts", "scripts/check-january-scenario-artifact.ts", "tools/scenario-shadow/**"]
    },
    "simulation": {
      "agentGuide": "docs/agents/ARCHITECT-AGENT.md",
      "docs": ["docs/simulation/**", "docs/engineering/**", "docs/architecture/AI-FIRST-GAME-DEVELOPMENT.md"],
      "code": ["packages/game-simulation/**", "fixtures/**"]
    },
    "tooling": {
      "agentGuide": "docs/agents/ARCHITECT-AGENT.md",
      "docs": ["docs/architecture/AI-FIRST-GAME-DEVELOPMENT.md", "docs/engineering/**"],
      "code": [".studio/**", ".agents/skills/**", ".github/**", "scripts/studio/**", "scripts/studioctl.mjs", "scripts/versioning.mjs", "scripts/versioning.d.mts", "scripts/gamectl.ts", "scripts/gamectl-entry.ts", "scripts/gamectl-capabilities.mjs", "scripts/gamectl-capabilities.d.mts", "packages/game-devtools/**", "nx.json"]
    },
    "canon": {
      "agentGuide": "docs/agents/ARCHITECT-AGENT.md",
      "docs": ["docs/adr/**", "docs/game-design/**", "docs/architecture/**", "docs/plans/**"],
      "code": []
    }
  }
}
