{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../.tsbuild/tests",
    "tsBuildInfoFile": "../.tsbuild/tests.tsbuildinfo",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../apps/desktop/css-modules.d.ts",
    "../apps/desktop/src/App.tsx",
    "../apps/desktop/src/RuntimeDesktop.tsx",
    "../apps/desktop/src/january/**/*.ts",
    "../apps/desktop/src/january/**/*.tsx",
    "../apps/desktop/src/overview/**/*.ts",
    "../apps/desktop/src/overview/**/*.tsx",
    "../apps/desktop/src/panels/**/*.ts",
    "../apps/desktop/src/panels/**/*.tsx",
    "../apps/desktop/src/performance/**/*.ts",
    "../apps/desktop/src/routing/**/*.ts",
    "../apps/desktop/src/routing/**/*.tsx",
    "../apps/desktop/src/shell/**/*.ts",
    "../apps/desktop/src/shell/**/*.tsx",
    "../scripts/performance/**/*.ts",
    "../vitest.config.ts"
  ],
  "exclude": [
    "../apps/desktop/src/january/**/*.stories.tsx",
    "../apps/desktop/src/overview/**/*.stories.tsx",
    "../apps/desktop/src/routing/**/*.stories.tsx",
    "../apps/desktop/src/shell/**/*.stories.tsx"
  ],
  "references": [
    { "path": "../packages/game-schema" },
    { "path": "../packages/game-core" },
    { "path": "../packages/game-application" },
    { "path": "../packages/game-content" },
    { "path": "../packages/game-content-compiler" },
    { "path": "../packages/game-persistence-contracts" },
    { "path": "../packages/game-ui" },
    { "path": "../packages/game-ui-fixtures" }
  ]
}
