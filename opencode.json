{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode-go/mimo-v2.5",
  "default_agent": "worker",
  "subagent_depth": 0,
  "share": "disabled",
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        ".studio\\runtime\\mcp\\github-mcp.cmd",
        "--read-only",
        "--toolsets=issues,pull_requests,repos,users",
        "stdio"
      ],
      "enabled": true,
      "environment": {}
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "environment": {
        "BROWSER": "chromium"
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      ".worktrees/**",
      ".studio/runtime/**",
      "apps/desktop/src-tauri/target/**",
      "apps/desktop/storybook-static/**",
      "storybook-static/**",
      "artifacts/performance/**"
    ]
  },
  "permission": {
    "task": "deny",
    "external_directory": "deny",
    "skill": "allow",
    "question": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git merge-base*": "allow",
      "pnpm *": "allow",
      "node *": "allow",
      "cargo *": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "gh pr merge*": "deny"
    }
  }
}
