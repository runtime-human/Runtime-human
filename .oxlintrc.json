{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-debugger": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/storybook-static/**",
    "**/target/**"
  ]
}
